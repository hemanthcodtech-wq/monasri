# Mona Sri Enterprises - Client Environment Variables (Template)

# Backend API URL (When deploying client to Vercel, set this to your Render service URL, e.g. https://mona-sri-server.onrender.com)
VITE_API_URL=http://localhost:5001

# Mapbox Access Token (Optional: insert your own Mapbox public token for live maps)
VITE_MAPBOX_TOKEN=
