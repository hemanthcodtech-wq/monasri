{
  "name": "tradexx-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,green\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:all": "npm run dev",
    "server": "npm run dev --prefix server",
    "server:start": "npm start --prefix server",
    "client": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "test:api": "npm test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
